## Copy this file to keystore.properties (same directory, project root) and fill in your
## real values after running keytool to generate app/upload-keystore.jks.
## keystore.properties is gitignored -- never commit the real file or its passwords.

storeFile=app/upload-keystore.jks
storePassword=YOUR_KEYSTORE_PASSWORD
keyAlias=usctest-upload
keyPassword=YOUR_KEY_PASSWORD
