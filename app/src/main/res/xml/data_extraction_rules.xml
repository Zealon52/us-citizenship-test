<?xml version="1.0" encoding="utf-8"?>
<!-- API 31+ Auto Backup / device transfer rules. The officials-data cache (officials_cache.json
     in filesDir) is just a locally fetched copy of public congressional data, re-fetchable or
     falls back to the bundled asset, so there's no need to carry it across backups/transfers. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="officials_cache.json" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="officials_cache.json" />
    </device-transfer>
</data-extraction-rules>
